#include <ESP8266WiFi.h>
#include <ESP8266HTTPClient.h>
#include <WiFiClientSecure.h>
#include <time.h>

// ===================== Wi-Fi настройки =====================
#define WIFI_SSID    "TP-Link_515A"
#define WIFI_PASS   "21857638"

// ============== URL для Google Apps Script ==============
const char* googleScriptURL = "https://script.google.com/macros/s/AKfycbw4ZIH-N6HEYsZ258Qa0_YmKw3z7vhcrP97QfXG_pLZ6ipZCWxIkcb181wMfsDGRQQy/exec";

// ZMPT101B (вольтметр)
#define VOLTAGE_PIN A0

// ===================== НАСТРОЙКИ =====================
// БАЗОВЫЕ НАСТРОЙКИ ДЛЯ ДИАГНОСТИКИ
const float VOLTAGE_CALIBRATION = 0.0140;
const float RMS_VOLTAGE = 230.0;
const int SAMPLES = 200;

// ===================== ПЕРЕМЕННЫЕ =====================
unsigned long lastSend = 0;
bool wifiConnected = false;

// ===================== SETUP =====================
void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n\n🔧 МОНИТОРИНГ НАПРЯЖЕНИЯ СЕТИ");
  Serial.println("==================================");
  
  // Проверка аналогового входа
  Serial.print("Проверка пина A0... ");
  pinMode(A0, INPUT);
  int testRead = analogRead(A0);
  Serial.print("RAW значение: ");
  Serial.println(testRead);
  
  if (testRead < 10) {
    Serial.println("⚠️  ВНИМАНИЕ: Низкое значение A0!");
    Serial.println("   Проверьте подключение датчика");
  } else if (testRead > 1000) {
    Serial.println("⚠️  ВНИМАНИЕ: Высокое значение A0!");
  } else {
    Serial.println("✅ Пин A0 в норме");
  }
  
  // Подключение Wi-Fi
  connectWiFi();
  
  Serial.println("\n✅ Начинаем мониторинг...");
  lastSend = millis();
}

// ===================== LOOP =====================
void loop() {
  static unsigned long lastRead = 0;
  
  // Измерение каждые 2 секунды
  if (millis() - lastRead >= 2000) {
    readAndDisplayVoltage();
    lastRead = millis();
  }
  
  // Отправка каждые 60 секунд
  if (wifiConnected && millis() - lastSend >= 60000) {
    sendToGoogle();
    lastSend = millis();
  }
  
  delay(100);
}

// ===================== ЧТЕНИЕ НАПРЯЖЕНИЯ =====================
float readVoltage() {
  float maxVoltage = 0;
  float minVoltage = 1024;
  
  for (int i = 0; i < SAMPLES; i++) {
    int rawValue = analogRead(VOLTAGE_PIN);
    float voltage = rawValue * VOLTAGE_CALIBRATION;
    
    if (voltage > maxVoltage) maxVoltage = voltage;
    if (voltage < minVoltage) minVoltage = voltage;
    
    delayMicroseconds(100);
  }
  
  float peakToPeak = maxVoltage - minVoltage;
  float rmsVoltage = peakToPeak / 2.828;
  float realVoltage = rmsVoltage * (RMS_VOLTAGE / 1.414);
  
  return realVoltage;
}

// ===================== ЧТЕНИЕ И ОТОБРАЖЕНИЕ =====================
void readAndDisplayVoltage() {
  // Читаем RAW значение для диагностики
  int rawValue = analogRead(VOLTAGE_PIN);
  
  // Читаем напряжение
  float voltage = readVoltage();
  int voltageInt = round(voltage); // Округляем до целого
  
  Serial.print("\n📊 ИЗМЕРЕНИЕ: ");
  Serial.print(millis() / 1000);
  Serial.print("с | RAW: ");
  Serial.print(rawValue);
  Serial.print(" | Напряжение: ");
  Serial.print(voltageInt); // Выводим целое число
  Serial.println("V");
  
  // Проверка аномалий
  if (rawValue < 50) {
    Serial.println("⚠️  ОПАСНО: Низкое RAW значение! Проверьте датчик!");
  }
  
  if (voltageInt < 180) {
    Serial.print("🔴 КРИТИЧЕСКИ НИЗКОЕ: ");
    Serial.print(voltageInt);
    Serial.println("V");
  } else if (voltageInt < 210) {
    Serial.print("🟡 НИЗКОЕ: ");
    Serial.print(voltageInt);
    Serial.println("V");
  } else if (voltageInt > 250) {
    Serial.print("🟡 ВЫСОКОЕ: ");
    Serial.print(voltageInt);
    Serial.println("V");
  }
}

// ===================== ПОДКЛЮЧЕНИЕ WI-FI =====================
void connectWiFi() {
  Serial.println("\n📡 Подключение к Wi-Fi...");
  
  WiFi.hostname("WEMOS-VOLTAGE");
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  
  unsigned long startTime = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - startTime < 30000) {
    delay(500);
    Serial.print(".");
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    wifiConnected = true;
    Serial.println("\n✅ Wi-Fi подключен!");
    Serial.print("IP: ");
    Serial.println(WiFi.localIP());
    
    // Настройка времени
    configTime(2 * 3600, 0, "pool.ntp.org", "time.nist.gov");
  } else {
    Serial.println("\n❌ Ошибка подключения Wi-Fi!");
  }
}

// ===================== ОТПРАВКА В GOOGLE =====================
void sendToGoogle() {
  if (!wifiConnected) return;
  
  Serial.println("\n📤 Отправка данных...");
  
  // Получаем время
  struct tm timeinfo;
  if (!getLocalTimeFromESP(&timeinfo)) {
    Serial.println("❌ Не удалось получить время");
    return;
  }
  
  char timeStr[20];
  strftime(timeStr, sizeof(timeStr), "%Y-%m-%d %H:%M:00", &timeinfo);
  
  // Читаем текущее напряжение и округляем до целого
  float voltageFloat = readVoltage();
  int voltageInt = round(voltageFloat); // Округляем до целого числа
  
  // Формируем URL
  String url = String(googleScriptURL)
             + "?sheet=HOME"
             + "&time=" + urlencode(String(timeStr))
             + "&volt=" + String(voltageInt);  // Просто число без "V"
  
  Serial.println("=== ОТЛАДКА ОТПРАВКИ ===");
  Serial.print("Время: ");
  Serial.println(timeStr);
  Serial.print("Напряжение (число): ");
  Serial.println(voltageInt);
  Serial.print("Полный URL: ");
  Serial.println(url);
  
  WiFiClientSecure client;
  client.setInsecure();
  
  HTTPClient http;
  http.begin(client, url);
  http.setTimeout(10000);
  
  int httpCode = http.GET();
  
  if (httpCode > 0) {
    if (httpCode == HTTP_CODE_OK) {
      String response = http.getString();
      Serial.println("✅ Данные отправлены успешно");
      Serial.print("Ответ сервера: ");
      Serial.println(response);
    } else {
      Serial.print("⚠️  Код ответа: ");
      Serial.println(httpCode);
      String response = http.getString();
      Serial.print("Ответ: ");
      Serial.println(response);
    }
  } else {
    Serial.print("❌ Ошибка: ");
    Serial.println(http.errorToString(httpCode));
  }
  
  http.end();
}

// ===================== ПОЛУЧЕНИЕ ВРЕМЕНИ =====================
bool getLocalTimeFromESP(struct tm * info) {
  uint32_t start = millis();
  time_t now;
  
  while ((millis() - start) <= 5000) {
    time(&now);
    localtime_r(&now, info);
    
    if (info->tm_year > (2016 - 1900)) {
      return true;
    }
    delay(10);
  }
  return false;
}

// ===================== URLENCODE =====================
String urlencode(const String &str) {
  String encoded;
  char c, code0, code1;
  for (size_t i = 0; i < str.length(); i++) {
    c = str.charAt(i);
    if (isalnum(c)) {
      encoded += c;
    } else if (c == ' ') {
      encoded += '+';
    } else {
      code1 = (c & 0xF) + '0';
      if ((c & 0xF) > 9) code1 = (c & 0xF) - 10 + 'A';
      code0 = ((c >> 4) & 0xF) + '0';
      if (((c >> 4) & 0xF) > 9) code0 = ((c >> 4) & 0xF) - 10 + 'A';
      encoded += '%';
      encoded += code0;
      encoded += code1;
    }
  }
  return encoded;
}
