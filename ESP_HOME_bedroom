  function renderBattery(level) {
    var lvl = Math.max(0, Math.min(100, Math.round(level)));
    batteryValue.textContent = lvl + '%';
    batteryFill.style.width = lvl + '%';

    var c1, c2, cIcon;
    if (lvl <= 15)      { c1 = '#fca5a5'; c2 = '#e11d48'; cIcon = '#e11d48'; }
    else if (lvl <= 35) { c1 = '#fcd34d'; c2 = '#f59e0b'; cIcon = '#e0a94e'; }
    else                { c1 = '#7ee0a4'; c2 = '#10b981'; cIcon = '#10b981'; }

    batteryFill.style.background = 'linear-gradient(90deg, ' + c1 + ', ' + c2 + ')';

    var trackW = 21, padX = 1.8;
    var maxW = trackW - padX * 2;
    var w = Math.max(0.8, (lvl / 100) * maxW);
    batteryFillIcon.setAttribute('width', w.toFixed(2));
    batteryFillIcon.setAttribute('fill', cIcon);
