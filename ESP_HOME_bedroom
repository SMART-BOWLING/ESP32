// ================== ФУНКЦИИ ==================
void applyBrightness(int percent) {
  percent = constrain(percent, 0, 100);
  brightness = percent;
  pwmValue = map(percent, 0, 100, 0, PWM_RANGE);
  analogWrite(PWM_PIN, pwmValue);
  Serial.print("[PWM] Яркость: ");
  Serial.print(percent);
  Serial.print("%  ШИМ: ");
  Serial.println(pwmValue);
}

void saveBrightness() {
  EEPROM.write(0, brightness);
  EEPROM.commit();
}

void loadBrightness() {
  int val = EEPROM.read(0);
  if (val < 0 || val > 100) val = 70;
  applyBrightness(val);
}

void handleRoot() {
  Serial.println("[HTTP] GET / — отдаю пульт");
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");
  server.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
}

void handleSet() {
  Serial.print("[HTTP] GET /set ");
  for (uint8_t i = 0; i < server.args(); i++) {
    Serial.print(server.argName(i));
    Serial.print("=");
    Serial.print(server.arg(i));
    Serial.print(" ");
  }
  Serial.println();

  if (server.hasArg("val")) {
    int val = server.arg("val").toInt();
    applyBrightness(val);
    saveBrightness();
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.sendHeader("Cache-Control", "no-store");
    server.send(200, "text/plain", "OK");
  } else {
    server.send(400, "text/plain", "Missing 'val'");
  }
}

void handleNotFound() {
  Serial.print("[HTTP] 404: ");
  Serial.println(server.uri());
  server.send(404, "text/plain", "Not Found");
}

// ================== SETUP / LOOP ==================
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println();
  Serial.println("=====================================");
  Serial.println("     WEMOS D1 MINI PRO — СТАРТ v5");
  Serial.println("=====================================");

  EEPROM.begin(512);
  loadBrightness();

  analogWriteRange(PWM_RANGE);
  analogWriteFreq(1000);
  pinMode(PWM_PIN, OUTPUT);
  analogWrite(PWM_PIN, pwmValue);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.print("[WiFi] Подключение");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("[WiFi] IP: ");
  Serial.println(WiFi.localIP());

  server.on("/",    handleRoot);
  server.on("/set", handleSet);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("[HTTP] Сервер запущен");
  Serial.println("=====================================");
}

void loop() {
  server.handleClient();
}
