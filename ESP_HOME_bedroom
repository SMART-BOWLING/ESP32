  tg1.addEventListener('click', function() {
    on1 = !on1;
    localStorage.setItem('p1_on', on1 ? '1' : '0');
    visual1();
  });
  br1.addEventListener('input', function() {
    b1 = parseInt(br1.value, 10);
    localStorage.setItem('p1_brightness', String(b1));
  });
