#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <EEPROM.h>

// ================== НАСТРОЙКИ ==================
const char* ssid     = "TP-Link_515A";
const char* password = "21857638";

#define PWM_PIN   D1
#define PWM_RANGE 1023

ESP8266WebServer server(80);
int brightness = 70;
int pwmValue   = 0;

void applyBrightness(int percent) {
  percent = constrain(percent, 0, 100);
  brightness = percent;
  pwmValue = map(percent, 0, 100, 0, PWM_RANGE);
  analogWrite(PWM_PIN, pwmValue);
  Serial.printf("[PWM] %d%% -> %d\n", percent, pwmValue);
}

void saveBrightness() { EEPROM.write(0, brightness); EEPROM.commit(); }
void loadBrightness() {
  int v = EEPROM.read(0);
  if (v < 0 || v > 100) v = 70;
  applyBrightness(v);
}

void sendCORS() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "GET, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "*");
  server.sendHeader("Cache-Control", "no-store");
}

void handleSet() {
  sendCORS();
  if (server.hasArg("val")) {
    int v = server.arg("val").toInt();
    applyBrightness(v);
    saveBrightness();
    server.send(200, "text/plain", "OK");
  } else {
    server.send(400, "text/plain", "Missing val");
  }
}

void handleStatus() {
  sendCORS();
  server.send(200, "application/json", "{\"val\":" + String(brightness) + "}");
}

void handleNotFound() {
  sendCORS();
  server.send(404, "text/plain", "Not Found");
}

void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println("\n=== ИСПОЛНИТЕЛЬ (1 MOSFET) ===");

  EEPROM.begin(512);
  loadBrightness();
  analogWriteRange(PWM_RANGE);
  analogWriteFreq(1000);
  pinMode(PWM_PIN, OUTPUT);
  analogWrite(PWM_PIN, pwmValue);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.print("[WiFi] Connecting");
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
  Serial.printf("\n[WiFi] IP: %s\n", WiFi.localIP().toString().c_str());
  Serial.println(">>> ЗАПОМНИ ЭТОТ IP — впиши его в ГЛАВНЫЙ скетч в EXECUTOR_IP <<<");

  server.on("/set",     handleSet);
  server.on("/status",  handleStatus);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("[HTTP] Ready");
}

void loop() { server.handleClient(); }
