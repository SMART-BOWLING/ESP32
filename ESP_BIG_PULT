int coldPercent = 70;
int warmPercent = 50;

// ====== INA219 / LiFePO4 ======
float busVoltage = 0.0;
float shuntVoltage = 0.0;
float current_mA = 0.0;   // + заряд / - разряд (зависит от подключения)
float power_mW = 0.0;

// ====== LiFePO4 4S (12V) ======
const float LFP_MIN = 10.0;   // 0%
const float LFP_MAX = 14.6;   // 100%

int voltageToPercent(float v) {
  if (v <= LFP_MIN) return 0;
  if (v >= LFP_MAX) return 100;
  // Нелинейная полка LiFePO4 — приблизительная кривая
  if (v < 12.0)  return map((int)(v*100), (int)(LFP_MIN*100), 1200, 0, 10);
  if (v < 12.8)  return map((int)(v*100), 1200, 1280, 10, 20);
  if (v < 13.0)  return map((int)(v*100), 1280, 1300, 20, 30);
  if (v < 13.2)  return map((int)(v*100), 1300, 1320, 30, 50);
  if (v < 13.3)  return map((int)(v*100), 1320, 1330, 50, 70);
  if (v < 13.6)  return map((int)(v*100), 1330, 1360, 70, 90);
  return map((int)(v*100), 1360, (int)(LFP_MAX*100), 90, 100);
}

void readINA() {
  busVoltage   = ina219.getBusVoltage_V();
  shuntVoltage = ina219.getShuntVoltage_mV();
  current_mA   = ina219.getCurrent_mA();
  power_mW     = ina219.getPower_mW();
}

void applyCold(int percent) {
  percent = constrain(percent, 0, 100);
  coldPercent = percent;
  analogWrite(PIN_COLD, map(percent, 0, 100, 0, PWM_RANGE));
  Serial.printf("[COLD] %d%%\n", percent);
}

void applyWarm(int percent) {
  percent = constrain(percent, 0, 100);
  warmPercent = percent;
  analogWrite(PIN_WARM, map(percent, 0, 100, 0, PWM_RANGE));
  Serial.printf("[WARM] %d%%\n", percent);
}

void saveAll() {
  EEPROM.write(EE_COLD, coldPercent);
  EEPROM.write(EE_WARM, warmPercent);
  EEPROM.commit();
}

void loadAll() {
  int c = EEPROM.read(EE_COLD);
  int w = EEPROM.read(EE_WARM);
  if (c < 0 || c > 100) c = 70;
  if (w < 0 || w > 100) w = 50;
  applyCold(c);
  applyWarm(w);
}

void sendCORS() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "GET, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "*");
  server.sendHeader("Cache-Control", "no-store");
}

// ====== Проксирование команды на исполнителя ======
void proxyToExecutor(int val) {
  WiFiClient client;
  if (client.connect(EXECUTOR_IP, 80)) {
    String req = String("GET /set?val=") + val + " HTTP/1.1\r\n" +
                 "Host: " + EXECUTOR_IP + "\r\n" +
                 "Connection: close\r\n\r\n";
    client.print(req);
    Serial.printf("[PROXY] -> %s /set?val=%d\n", EXECUTOR_IP, val);
    client.stop();
  } else {
    Serial.printf("[PROXY] ERR connect %s\n", EXECUTOR_IP);
  }
}

