// ================== HTTP ==================
void handleRoot() {
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");
  server.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
}

void handleIcon() {
  server.sendHeader("Cache-Control", "public, max-age=86400");
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send_P(200, "image/svg+xml; charset=utf-8", ICON_SVG);
}

void handleManifest() {
  server.sendHeader("Cache-Control", "no-store");
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send_P(200, "application/manifest+json; charset=utf-8", MANIFEST_JSON);
}

void handleSet() {
  sendCORS();
  bool hasBright = server.hasArg("bright");
  bool hasTone   = server.hasArg("tone");
  if (!hasBright && !hasTone) { server.send(400, "text/plain", "Missing bright/tone"); return; }

  if (hasBright) {
    String s = server.arg("bright");
    int v = s.toInt();
    if (s.length() == 0 || v < 0 || v > 100) { server.send(400, "text/plain", "Bad bright"); return; }
    brightPercent = v;
  }
  if (hasTone) {
    String s = server.arg("tone");
    int v = s.toInt();
    if (s.length() == 0 || v < 0 || v > 100) { server.send(400, "text/plain", "Bad tone"); return; }
    tonePercent = v;
  }

  applyLight();
  lastSetMs   = millis();
  savePending = true;
  server.send(200, "text/plain", "OK");
}

void handleStatus() {
  sendCORS();
  String json = "{\"bright\":"     + String(brightPercent) +
                ",\"tone\":"       + String(tonePercent)   +
                ",\"cold\":"       + String(coldPercent)   +
                ",\"warm\":"       + String(warmPercent)   +
                ",\"lastBright\":" + String(getLastBright()) +
                ",\"wifi\":"       + String(WiFi.status()) +
                ",\"ip\":\""       + WiFi.localIP().toString() + "\"}";
  server.send(200, "application/json", json);
}

void handleNotFound() {
  sendCORS();
  server.send(404, "text/plain", "Not Found");
}

// ================== SETUP / LOOP ==================
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println();
  Serial.println("=====================================");
  Serial.println("   ГОСТИНАЯ — 2 MOSFET (D5/D6)");
  Serial.println("=====================================");

  pinMode(PIN_COLD, OUTPUT);
  pinMode(PIN_WARM, OUTPUT);
  analogWriteRange(PWM_RANGE);
  analogWriteFreq(2000);

  EEPROM.begin(512);
  loadAll();
  applyLight();

  server.on("/",              handleRoot);
  server.on("/set",           handleSet);
  server.on("/status",        handleStatus);
  server.on("/icon.svg",      handleIcon);
  server.on("/manifest.json", handleManifest);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("[HTTP] Server started");

  // WiFi
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.setSleepMode(WIFI_NONE_SLEEP);
  WiFi.setOutputPower(20.5);

  if (!WiFi.config(STATIC_IP, GATEWAY, SUBNET, DNS1, DNS2)) {
    Serial.println("[WiFi] config() FAILED — будет DHCP");
  }
  Serial.print("[WiFi] MAC: ");
  Serial.println(WiFi.macAddress());

  connectWiFiWithTimeout(WIFI_INITIAL_TIMEOUT_MS);
  Serial.println("=====================================");
}

void loop() {
  server.handleClient();
  maintainWiFi();

  if (savePending && (millis() - lastSetMs > SAVE_DELAY_MS)) {
    saveAll();
    savePending = false;
  }
}
