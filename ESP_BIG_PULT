// ====== Пины 2 MOSFET ======
#define PIN_COLD  D5   // холодный свет (GPIO14)
#define PIN_WARM  D6   // тёплый свет  (GPIO12)

#define PWM_RANGE 1023

// ====== EEPROM ======
#define EE_BRIGHT 0
#define EE_TONE   1

ESP8266WebServer server(80);

int brightPercent = 70;
int tonePercent   = 50;
int coldPercent   = 0;
int warmPercent   = 0;

void applyLight() {
  brightPercent = constrain(brightPercent, 0, 100);
  tonePercent   = constrain(tonePercent, 0, 100);

  int c, w;
  if (tonePercent <= 50) {
    c = brightPercent;
    w = (brightPercent * tonePercent) / 50;
  } else {
    w = brightPercent;
    c = (brightPercent * (100 - tonePercent)) / 50;
  }

  coldPercent = c;
  warmPercent = w;

  analogWrite(PIN_COLD, map(coldPercent, 0, 100, 0, PWM_RANGE));
  analogWrite(PIN_WARM, map(warmPercent, 0, 100, 0, PWM_RANGE));

  Serial.printf("[LIGHT] bright=%d%% tone=%d%% -> cold=%d%% warm=%d%%\n",
                brightPercent, tonePercent, coldPercent, warmPercent);
}

void saveAll() {
  EEPROM.write(EE_BRIGHT, brightPercent);
  EEPROM.write(EE_TONE,   tonePercent);
  EEPROM.commit();
}

void loadAll() {
  int b = EEPROM.read(EE_BRIGHT);
  int t = EEPROM.read(EE_TONE);
  if (b < 0 || b > 100) b = 70;
  if (t < 0 || t > 100) t = 50;
  brightPercent = b;
  tonePercent   = t;
}

void sendCORS() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "GET, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "*");
  server.sendHeader("Cache-Control", "no-store");
}

