  br2.addEventListener('change', function() {
    cur2 = parseInt(br2.value, 10);
    if (cur2 > 0) lastNonZero2 = cur2;
    localStorage.setItem('exec_brightness', String(cur2));
    visual2();
    queueExec(cur2);
