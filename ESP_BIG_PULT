      .then(function(r){ setDot(dot2, true); })
      .catch(function(e){ setDot(dot2, false); });
  }

  var t2 = null, pending2 = null;
  function queueExec(v, immediate) {
    pending2 = v;
    if (immediate) {
      if (t2) { clearTimeout(t2); t2 = null; }
      var x = pending2; pending2 = null;
      sendExec(x);
      return;
    }
    if (t2) return;
    t2 = setTimeout(function() {
      t2 = null;
      var x = pending2; pending2 = null;
      if (x != null) sendExec(x);
    }, 80);
  }

  br2.addEventListener('input', function() {
    cur2 = parseInt(br2.value, 10);
    if (cur2 > 0) lastNonZero2 = cur2;
    visual2();
    queueExec(cur2, false);
  });
  br2.addEventListener('change', function() {
    cur2 = parseInt(br2.value, 10);
    if (cur2 > 0) lastNonZero2 = cur2;
    localStorage.setItem('exec_brightness', String(cur2));
    visual2();
    queueExec(cur2, true);
  });
  tg2.addEventListener('click', function() {
    if (cur2 > 0) { lastNonZero2 = cur2; cur2 = 0; }
    else { cur2 = lastNonZero2 || 70; }
    br2.value = cur2;
    localStorage.setItem('exec_brightness', String(cur2));
    visual2();
    queueExec(cur2, true);
  });

  // ---------- СТАРТ ----------
  visual1();
  visual2();
  queueMain({ val: on1 ? b1 : 0, temp: t1 }, true);
  queueExec(cur2, true);
  fetchBattery();
  setInterval(fetchBattery, 15000);

  console.log('[PULT] ===== ГОТОВ =====');
})();
</script>
</body>
</html>)HTML";

// ================== ОБРАБОТЧИКИ HTTP ==================
void handleRoot() {
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");
  server.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
}

void handleSet() {
  sendCORS();
  bool changed = false;

  if (server.hasArg("val")) {
    int v = server.arg("val").toInt();
    applyCold(v);
    // проксируем на исполнителя — там своя лампа
    proxyToExecutor(v);
    changed = true;
  }
  if (server.hasArg("temp")) {
    applyWarm(server.arg("temp").toInt());
    changed = true;
  }

  if (changed) {
    saveAll();
    server.send(200, "text/plain", "OK");
  } else {
    server.send(400, "text/plain", "Missing val/temp");
  }
}

void handleBattery() {
  sendCORS();
  readINA();

  int lvl = voltageToPercent(busVoltage);
  float amps = current_mA / 1000.0;
  float watts = power_mW / 1000.0;

  String json = "{\"level\":" + String(lvl) +
                ",\"volts\":" + String(busVoltage, 2) +
                ",\"amps\":"  + String(amps, 3) +
                ",\"watts\":" + String(watts, 3) + "}";
  server.send(200, "application/json", json);
}

void handleStatus() {
  sendCORS();
  String json = "{\"cold\":" + String(coldPercent) +
                ",\"warm\":" + String(warmPercent) + "}";
  server.send(200, "application/json", json);
}

void handleNotFound() {
  sendCORS();
  server.send(404, "text/plain", "Not Found");
}

// ================== SETUP / LOOP ==================
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println();
  Serial.println("=====================================");
  Serial.println("   ГЛАВНЫЙ ESP — 2 MOSFET + INA219");
  Serial.println("=====================================");

  EEPROM.begin(512);
  loadAll();

  analogWriteRange(PWM_RANGE);
  analogWriteFreq(1000);
  pinMode(PIN_COLD, OUTPUT);
  pinMode(PIN_WARM, OUTPUT);
  analogWrite(PIN_COLD, map(coldPercent, 0, 100, 0, PWM_RANGE));
  analogWrite(PIN_WARM, map(warmPercent, 0, 100, 0, PWM_RANGE));

  // INA219
  Wire.begin(INA_SDA, INA_SCL);
  if (!ina219.begin()) {
    Serial.println("[INA219] НЕ НАЙДЕН! Проверь I2C (D5=SDA, D6=SCL)");
  } else {
    Serial.println("[INA219] OK");
    // Стандартный модуль: шунт 0.1 Ом, макс 3.2 А / 32 В
    ina219.setCalibration_32V_2A();
  }

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.print("[WiFi] Подключение");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("[WiFi] IP: ");
  Serial.println(WiFi.localIP());
  Serial.print("[WiFi] Исполнитель (EXECUTOR_IP): ");
  Serial.println(EXECUTOR_IP);

  server.on("/",        handleRoot);
  server.on("/set",     handleSet);
  server.on("/battery", handleBattery);
  server.on("/status",  handleStatus);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("[HTTP] Сервер запущен");
  Serial.println("=====================================");
}

void loop() {
  server.handleClient();
}
