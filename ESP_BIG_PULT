  var pending2  = null;
  var inFlight2 = false;

  function sendExecNow(percent) {
    inFlight2 = true;
    var v = Math.max(0, Math.min(100, Math.round(percent)));
    var url = EXECUTOR + '/set?val=' + v + '&_=' + Date.now();
    fetch(url, { cache: 'no-store' })
      .then(function(){ setDot(dot2, true); })
      .catch(function(){ setDot(dot2, false); })
      .then(function(){
        inFlight2 = false;
        if (pending2 != null) {
          var x = pending2; pending2 = null;
          sendExecNow(x);
        }
      });
  }

  function queueExec(v) {
    pending2 = v;
    if (!inFlight2) {
      var x = pending2; pending2 = null;
      sendExecNow(x);
    }
  }

  br2.addEventListener('input', function() {
    cur2 = parseInt(br2.value, 10);
    if (cur2 > 0) lastNonZero2 = cur2;
    visual2();
    queueExec(cur2);
