// ================== ОБРАБОТЧИКИ HTTP ==================
void handleRoot() {
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");
  server.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
}

void handleIcon() {
  server.sendHeader("Cache-Control", "public, max-age=86400");
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send_P(200, "image/svg+xml; charset=utf-8", ICON_SVG);
}

void handleManifest() {
  server.sendHeader("Cache-Control", "no-store");
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send_P(200, "application/manifest+json; charset=utf-8", MANIFEST_JSON);
}

void handleSet() {
  sendCORS();
  bool changed = false;

  if (server.hasArg("bright")) {
    brightPercent = server.arg("bright").toInt();
    changed = true;
  }
  if (server.hasArg("tone")) {
    tonePercent = server.arg("tone").toInt();
    changed = true;
  }
  if (server.hasArg("val") && !server.hasArg("bright")) {
    brightPercent = server.arg("val").toInt();
    changed = true;
  }

  if (changed) {
    applyLight();
    saveAll();
    server.send(200, "text/plain", "OK");
  } else {
    server.send(400, "text/plain", "Missing bright/tone");
  }
}

void handleStatus() {
  sendCORS();
  String json = "{\"bright\":" + String(brightPercent) +
                ",\"tone\":"   + String(tonePercent) +
                ",\"cold\":"   + String(coldPercent) +
                ",\"warm\":"   + String(warmPercent) + "}";
  server.send(200, "application/json", json);
}

void handleNotFound() {
  sendCORS();
  server.send(404, "text/plain", "Not Found");
}

// ================== SETUP / LOOP ==================
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println();
  Serial.println("=====================================");
  Serial.println("   ГЛАВНЫЙ ESP — 2 MOSFET (D5/D6)");
  Serial.println("   Без INA219");
  Serial.println("=====================================");

  EEPROM.begin(512);
  loadAll();

  analogWriteRange(PWM_RANGE);
  analogWriteFreq(1000);
  pinMode(PIN_COLD, OUTPUT);
  pinMode(PIN_WARM, OUTPUT);
  applyLight();

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.print("[WiFi] Подключение");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("[WiFi] IP: ");
  Serial.println(WiFi.localIP());

  server.on("/",              handleRoot);
  server.on("/set",           handleSet);
  server.on("/status",        handleStatus);
  server.on("/icon.svg",      handleIcon);
  server.on("/manifest.json", handleManifest);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("[HTTP] Сервер запущен");
  Serial.println("=====================================");
}

void loop() {
  server.handleClient();
}
