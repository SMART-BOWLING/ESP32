      .then(function(r){ return r.json(); })
      .then(function(d){
        if (typeof d.bright === 'number') {
          b1 = Math.max(0, Math.min(100, d.bright));
          br1.value = b1;
        }
        if (typeof d.tone === 'number') {
          t1 = Math.max(0, Math.min(100, d.tone));
          tn1.value = t1;
        }
        localStorage.setItem('p1_bright', String(b1));
        localStorage.setItem('p1_tone',   String(t1));
        if (b1 > 0) { lastB1 = b1; localStorage.setItem('p1_lastBright', String(b1)); }
        visual1();
        setDot(dot1, true);
      })
      .catch(function(){ setDot(dot1, false); });
  }

  function syncExec() {
    fetch(EXECUTOR + '/status?_=' + Date.now(), { cache: 'no-store' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (typeof d.val === 'number') {
          cur2 = Math.max(0, Math.min(100, d.val));
          br2.value = cur2;
