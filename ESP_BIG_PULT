<script>
(function(){
  'use strict';

  var CENTER=120, RADIUS=90, START=135, SPAN=270;
  var TEMP_CX=120, TEMP_CY=120, TEMP_R=121, TEMP_START=228, TEMP_SPAN=84;
  var TEMP_MIN=2700, TEMP_MAX=6500;
  var EXECUTOR='http://192.168.1.51';

  function clamp(v,a,b){ return Math.max(a,Math.min(b,v)); }
  function point(deg){
    return {x:CENTER+RADIUS*Math.sin(deg*Math.PI/180), y:CENTER-RADIUS*Math.cos(deg*Math.PI/180)};
  }
  function arcPath(a,b){
    var p=point(a),q=point(b);
    return 'M '+p.x+' '+p.y+' A '+RADIUS+' '+RADIUS+' 0 '+(b-a>180?1:0)+' 1 '+q.x+' '+q.y;
  }
  function tempPoint(deg){
    return {x:TEMP_CX+TEMP_R*Math.sin(deg*Math.PI/180), y:TEMP_CY-TEMP_R*Math.cos(deg*Math.PI/180)};
  }
  function tempArcPath(a,b){
    var p=tempPoint(a),q=tempPoint(b);
    return 'M '+p.x+' '+p.y+' A '+TEMP_R+' '+TEMP_R+' 0 '+(b-a>180?1:0)+' 1 '+q.x+' '+q.y;
  }

  function kelvinToTone(k){
    var n=(clamp(k,TEMP_MIN,TEMP_MAX)-TEMP_MIN)/(TEMP_MAX-TEMP_MIN);
    return Math.round((1-n)*100);
  }
  function toneToKelvin(t){
    var n=1-clamp(t,0,100)/100;
    return Math.round((TEMP_MIN+n*(TEMP_MAX-TEMP_MIN))/100)*100;
  }
  function mixColor(a,b,t){
    var x=parseInt(a.slice(1),16), y=parseInt(b.slice(1),16);
    var c=[16,8,0].map(function(s){
      return Math.round(((x>>s)&255)*(1-t)+((y>>s)&255)*t);
    });
    return '#'+c.map(function(v){return v.toString(16).padStart(2,'0');}).join('');
  }

  var cardMain=document.querySelector('.card[data-name="main"]');
  var dialMain=cardMain.querySelector('.dial');
  var trackMain=dialMain.querySelector('.track');
  var progMain=dialMain.querySelector('.progress');
  var thumbMain=dialMain.querySelector('.thumb');
  var valMain=cardMain.querySelector('.value');
  var statValMain=cardMain.querySelector('.status-value');
  var statTxtMain=cardMain.querySelector('.status-text');
  var toggleMain=cardMain.querySelector('.toggle');
  var tempHit=cardMain.querySelector('.temp-hit');
  var tempTrack=cardMain.querySelector('.temp-track');
  var tempThumb=cardMain.querySelector('.temp-thumb');
  var tempSpec=cardMain.querySelector('.temp-spectrum');

  var b1=parseInt(localStorage.getItem('p1_bright')||'70',10);
  if(isNaN(b1)||b1<0||b1>100) b1=70;
  var t1=parseInt(localStorage.getItem('p1_tone')||'50',10);
  if(isNaN(t1)||t1<0||t1>100) t1=50;
  var lastB1=parseInt(localStorage.getItem('p1_lastBright')||'70',10);
  if(isNaN(lastB1)||lastB1<=0||lastB1>100) lastB1=(b1>0?b1:70);
  var tempK=toneToKelvin(t1);

  trackMain.setAttribute('d', arcPath(START, START+SPAN));
  tempTrack.setAttribute('d', tempArcPath(TEMP_START, TEMP_START+TEMP_SPAN));

  (function(){
    var NS='http://www.w3.org/2000/svg';
    function colorForKelvin(k){
      return k<4000
        ? mixColor('#ff9855','#ffe4bd',(k-2700)/1300)
        : mixColor('#ffe4bd','#8dbfff',(k-4000)/2500);
    }
    var segs=64;
    for(var i=0;i<segs;i++){
      var a=TEMP_START+TEMP_SPAN*i/segs;
      var b=TEMP_START+TEMP_SPAN*(i+1)/segs+(i===segs-1?0:.12);
      var path=document.createElementNS(NS,'path');
      path.setAttribute('d', tempArcPath(a,b));
      path.setAttribute('stroke', colorForKelvin(TEMP_MIN+(TEMP_MAX-TEMP_MIN)*(i+.5)/segs));
      tempSpec.appendChild(path);
    }
    [[TEMP_START,TEMP_MIN],[TEMP_START+TEMP_SPAN,TEMP_MAX]].forEach(function(pair){
      var p=tempPoint(pair[0]);
      var cap=document.createElementNS(NS,'circle');
