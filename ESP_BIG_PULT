  tg2.addEventListener('click', function() {
    if (cur2 > 0) { lastNonZero2 = cur2; cur2 = 0; }
    else { cur2 = lastNonZero2 || 70; }
    br2.value = cur2;
    localStorage.setItem('exec_brightness', String(cur2));
    visual2();
    queueExec(cur2);
